{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|apply_patch|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/prose_lint.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/prose_lint.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
