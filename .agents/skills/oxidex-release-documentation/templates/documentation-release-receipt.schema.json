{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxidex.net/schemas/documentation-release-receipt.schema.json",
  "title": "OxiDex documentation release receipt",
  "type": "object",
  "required": ["schema_version", "version", "candidate_sha", "candidate_tree", "parity_receipt", "claims", "pages", "benchmarks", "local_build", "visual_review", "pages_pipeline", "live_deployment", "status", "unresolved"],
  "properties": {
    "schema_version": {"const": 1}, "version": {"type": ["string", "null"]}, "candidate_sha": {"type": ["string", "null"]}, "candidate_tree": {"type": ["string", "null"]},
    "main_equivalence": {"type": "object"}, "parity_receipt": {"type": "object"}, "claims": {"type": "array"}, "pages": {"type": "array"}, "benchmarks": {"type": "array"}, "local_build": {"type": "object"}, "visual_review": {"type": "object"}, "pages_pipeline": {"type": "object"}, "live_deployment": {"type": "object"},
    "status": {"enum": ["unverified", "blocked", "verified"]}, "unresolved": {"type": "array"}
  },
  "additionalProperties": false,
  "allOf": [{
    "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
    "then": {"properties": {
      "version": {"$ref": "#/$defs/nonempty"}, "candidate_sha": {"$ref": "#/$defs/commit"}, "candidate_tree": {"$ref": "#/$defs/commit"},
      "parity_receipt": {"type": "object", "required": ["path", "sha256", "measured_sha", "status"], "properties": {"path": {"$ref": "#/$defs/nonempty"}, "sha256": {"$ref": "#/$defs/sha256"}, "measured_sha": {"$ref": "#/$defs/commit"}, "status": {"const": "verified"}}, "additionalProperties": false},
      "claims": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["claim", "status", "evidence_path"], "properties": {"claim": {"$ref": "#/$defs/nonempty"}, "status": {"const": "verified"}, "evidence_path": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false}},
      "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["route", "disposition", "status"], "properties": {"route": {"$ref": "#/$defs/nonempty"}, "disposition": {"enum": ["current", "historical", "excluded"]}, "status": {"const": "verified"}}, "additionalProperties": false}},
      "benchmarks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["disposition"], "properties": {"disposition": {"enum": ["candidate", "historical", "not_applicable"]}, "reason": {"type": "string"}}, "additionalProperties": true}},
      "local_build": {"type": "object", "required": ["status", "command", "candidate_sha", "snapshot_path", "dist_path", "input_manifest", "source_inventory", "generated_inventory", "rendered_inventory", "reconciliation", "crawl_evidence", "evidence_path"], "properties": {"status": {"const": "verified"}, "command": {"$ref": "#/$defs/nonempty"}, "candidate_sha": {"$ref": "#/$defs/commit"}, "snapshot_path": {"$ref": "#/$defs/nonempty"}, "dist_path": {"$ref": "#/$defs/nonempty"}, "input_manifest": {"$ref": "#/$defs/nonempty"}, "source_inventory": {"$ref": "#/$defs/nonempty"}, "generated_inventory": {"$ref": "#/$defs/nonempty"}, "rendered_inventory": {"$ref": "#/$defs/nonempty"}, "reconciliation": {"$ref": "#/$defs/nonempty"}, "crawl_evidence": {"$ref": "#/$defs/nonempty"}, "evidence_path": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false},
      "visual_review": {"type": "object", "required": ["status", "automation_manifest", "samples", "findings", "human_review", "evidence_path"], "properties": {"status": {"const": "verified"}, "automation_manifest": {"$ref": "#/$defs/nonempty"}, "samples": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["route", "viewport", "theme", "status"], "properties": {"route": {"$ref": "#/$defs/nonempty"}, "viewport": {"$ref": "#/$defs/nonempty"}, "theme": {"$ref": "#/$defs/nonempty"}, "status": {"const": "verified"}}, "additionalProperties": false}}, "findings": {"maxItems": 0}, "human_review": {"type": "object", "required": ["status", "reviewer", "reviewed_at", "screenshot_manifest", "evidence_path"], "properties": {"status": {"const": "verified"}, "reviewer": {"$ref": "#/$defs/nonempty"}, "reviewed_at": {"$ref": "#/$defs/nonempty"}, "screenshot_manifest": {"$ref": "#/$defs/nonempty"}, "evidence_path": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false}, "evidence_path": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false},
      "pages_pipeline": {"type": "object", "required": ["status", "build_type", "https_enforced", "workflow_sha", "evidence_path"], "properties": {"status": {"const": "verified"}, "build_type": {"const": "workflow"}, "cname": {"type": ["string", "null"]}, "https_enforced": {"const": true}, "source": {"type": ["string", "null"]}, "workflow_sha": {"$ref": "#/$defs/commit"}, "evidence_path": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false},
      "unresolved": {"maxItems": 0}
    }}
  }],
  "$defs": {"nonempty": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
