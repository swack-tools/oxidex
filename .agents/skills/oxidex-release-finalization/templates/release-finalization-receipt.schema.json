{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxidex.net/schemas/release-finalization-receipt.schema.json",
  "title": "OxiDex finalization release receipt",
  "type": "object",
  "required": ["schema_version", "version", "tag", "candidate_sha", "candidate_tree", "main_sha", "main_tree", "receipts", "packaging", "version_inventory", "promotion", "authorization", "tag_verification", "gates", "workflows", "artifacts", "macos_verification", "status", "next_action"],
  "properties": {
    "schema_version": {"const": 1}, "version": {"type": ["string", "null"]}, "tag": {"type": ["string", "null"]}, "candidate_sha": {"type": ["string", "null"]}, "candidate_tree": {"type": ["string", "null"]}, "candidate_cargo_target_dir": {"type": ["string", "null"]}, "main_sha": {"type": ["string", "null"]}, "main_tree": {"type": ["string", "null"]},
    "receipts": {"type": "object"}, "packaging": {"type": "object"}, "version_inventory": {"type": "array"}, "promotion": {"type": "object"}, "authorization": {"type": "object"}, "tag_verification": {"type": "object"}, "gates": {"type": "array"}, "workflows": {"type": "array"}, "artifacts": {"type": "array"}, "macos_verification": {"type": "object"},
    "status": {"enum": ["unverified", "blocked", "verified"]}, "next_action": {"type": "string"}
  },
  "additionalProperties": false,
  "allOf": [{
    "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
    "then": {"properties": {
      "version": {"$ref": "#/$defs/nonempty"}, "tag": {"$ref": "#/$defs/nonempty"}, "candidate_sha": {"$ref": "#/$defs/commit"}, "candidate_tree": {"$ref": "#/$defs/commit"}, "main_sha": {"$ref": "#/$defs/commit"}, "main_tree": {"$ref": "#/$defs/commit"},
      "receipts": {"type": "object", "required": ["parity", "documentation"], "properties": {"parity": {"$ref": "#/$defs/upstream"}, "documentation": {"$ref": "#/$defs/upstream"}}, "additionalProperties": false},
      "packaging": {"type": "object", "required": ["prerelease", "latest", "targets", "expected_assets"], "properties": {"prerelease": {"type": "boolean"}, "latest": {"type": "boolean"}, "targets": {"$ref": "#/$defs/strings"}, "expected_assets": {"$ref": "#/$defs/strings"}}, "additionalProperties": false},
      "version_inventory": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "version", "status"], "properties": {"path": {"$ref": "#/$defs/nonempty"}, "version": {"$ref": "#/$defs/nonempty"}, "status": {"const": "verified"}}, "additionalProperties": false}},
      "promotion": {"type": "object", "required": ["pr_url", "review_decision", "required_checks_status", "unresolved_actionable_threads", "review_threads_evidence", "review_threads_sha256", "pr_state_evidence", "pr_state_sha256"], "properties": {"pr_url": {"$ref": "#/$defs/nonempty"}, "review_decision": {"const": "APPROVED"}, "required_checks_status": {"const": "success"}, "unresolved_actionable_threads": {"const": 0}, "review_threads_evidence": {"$ref": "#/$defs/nonempty"}, "review_threads_sha256": {"$ref": "#/$defs/sha256"}, "pr_state_evidence": {"$ref": "#/$defs/nonempty"}, "pr_state_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
      "authorization": {"type": "object", "required": ["authorized_by", "authorized_at", "version", "tag", "main_sha", "evidence_path"], "properties": {"authorized_by": {"$ref": "#/$defs/nonempty"}, "authorized_at": {"$ref": "#/$defs/nonempty"}, "version": {"$ref": "#/$defs/nonempty"}, "tag": {"$ref": "#/$defs/nonempty"}, "main_sha": {"$ref": "#/$defs/commit"}, "evidence_path": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false},
      "tag_verification": {"type": "object", "required": ["status", "tag", "target_sha", "signature", "evidence_path"], "properties": {"status": {"const": "verified"}, "tag": {"$ref": "#/$defs/nonempty"}, "target_sha": {"$ref": "#/$defs/commit"}, "signature": {"const": "good"}, "evidence_path": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false},
      "gates": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "status", "evidence_path"], "properties": {"name": {"$ref": "#/$defs/nonempty"}, "status": {"const": "verified"}, "evidence_path": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false}},
      "workflows": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["name", "status", "conclusion", "head_branch", "head_sha", "event", "run_id", "evidence_path"], "properties": {"name": {"enum": ["Release", "Docker"]}, "status": {"const": "completed"}, "conclusion": {"const": "success"}, "head_branch": {"$ref": "#/$defs/nonempty"}, "head_sha": {"$ref": "#/$defs/commit"}, "event": {"const": "push"}, "run_id": {"$ref": "#/$defs/positive"}, "evidence_path": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false}},
      "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "sha256", "size", "source_run_id"], "properties": {"name": {"$ref": "#/$defs/nonempty"}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"$ref": "#/$defs/positive"}, "source_run_id": {"$ref": "#/$defs/positive"}}, "additionalProperties": false}},
      "macos_verification": {"type": "object", "required": ["status", "release_run_id", "run_artifact_manifest", "expected_developer_id", "expected_team_identifier", "observed_developer_id", "observed_team_identifier", "raw_binary_sha256", "dmg_sha256", "dmg_payload_sha256", "payload_match", "reported_version", "gatekeeper_status", "stapler_status", "cleanup_status", "evidence"], "properties": {"status": {"const": "verified"}, "release_run_id": {"$ref": "#/$defs/positive"}, "run_artifact_manifest": {"$ref": "#/$defs/nonempty"}, "expected_developer_id": {"$ref": "#/$defs/nonempty"}, "expected_team_identifier": {"$ref": "#/$defs/nonempty"}, "observed_developer_id": {"$ref": "#/$defs/nonempty"}, "observed_team_identifier": {"$ref": "#/$defs/nonempty"}, "raw_binary_sha256": {"$ref": "#/$defs/sha256"}, "dmg_sha256": {"$ref": "#/$defs/sha256"}, "dmg_payload_sha256": {"$ref": "#/$defs/sha256"}, "payload_match": {"const": true}, "reported_version": {"$ref": "#/$defs/nonempty"}, "gatekeeper_status": {"const": "accepted"}, "stapler_status": {"const": "validated"}, "cleanup_status": {"const": "verified"}, "evidence": {"$ref": "#/$defs/strings"}}, "additionalProperties": false}
    }}
  }],
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "positive": {"type": "integer", "minimum": 1}, "strings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
    "upstream": {"type": "object", "required": ["path", "sha256", "measured_sha", "measured_tree", "status"], "properties": {"path": {"$ref": "#/$defs/nonempty"}, "sha256": {"$ref": "#/$defs/sha256"}, "measured_sha": {"$ref": "#/$defs/commit"}, "measured_tree": {"$ref": "#/$defs/commit"}, "status": {"const": "verified"}}, "additionalProperties": false}
  }
}
