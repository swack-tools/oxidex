{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OxiDex Beta 1 durable fleet state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_sha256",
    "spec_sha256",
    "target_ref",
    "target_sha",
    "merge_lease",
    "expected_merge_parent",
    "controller_identity",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_ref": {"type": "string", "minLength": 1},
    "target_sha": {"$ref": "#/$defs/sha"},
    "merge_lease": {"type": ["string", "null"]},
    "expected_merge_parent": {"$ref": "#/$defs/sha"},
    "controller_identity": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "number",
          "slug",
          "state",
          "state_history",
          "dependencies",
          "file_lease",
          "worker",
          "process",
          "launch_count",
          "prd_sha256",
          "report_sha256",
          "review_sha256",
          "base_sha",
          "head_sha",
          "pushed_sha",
          "merge_sha",
          "target_sha",
          "paths",
          "heartbeat",
          "pr_ci_state",
          "receipt_hashes",
          "ruling",
          "blocker",
          "expected_merge_parent",
          "next_command"
        ],
        "properties": {
          "number": {"type": "integer", "minimum": 0, "maximum": 20},
          "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "state": {"type": "string", "minLength": 1},
          "state_history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["state", "at"],
              "properties": {
                "state": {"type": "string"},
                "at": {"type": "string"},
                "detail": {"type": "string"}
              }
            }
          },
          "dependencies": {"type": "array", "items": {"type": "integer"}},
          "file_lease": {"type": "array", "items": {"type": "string"}},
          "worker": {
            "type": "object",
            "required": ["kind", "model", "effort", "identity"],
            "properties": {
              "kind": {"enum": ["CLI", "Desktop", "Controller"]},
              "model": {"type": "string"},
              "effort": {"type": "string"},
              "identity": {"type": ["string", "null"]}
            }
          },
          "process": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/process"}]},
          "launch_count": {"type": "integer", "minimum": 0},
          "prd_sha256": {"$ref": "#/$defs/nullableHash"},
          "report_sha256": {"$ref": "#/$defs/nullableHash"},
          "review_sha256": {"$ref": "#/$defs/nullableHash"},
          "base_sha": {"$ref": "#/$defs/nullableSha"},
          "head_sha": {"$ref": "#/$defs/nullableSha"},
          "pushed_sha": {"$ref": "#/$defs/nullableSha"},
          "merge_sha": {"$ref": "#/$defs/nullableSha"},
          "target_sha": {"$ref": "#/$defs/sha"},
          "paths": {
            "type": "object",
            "required": ["worktree", "target", "evidence", "prd", "report", "review"],
            "properties": {
              "worktree": {"type": "string"},
              "target": {"type": "string"},
              "evidence": {"type": "string"},
              "prd": {"type": "string"},
              "report": {"type": "string"},
              "review": {"type": "string"}
            }
          },
          "heartbeat": {"type": ["object", "null"]},
          "pr_ci_state": {"type": ["object", "null"]},
          "receipt_hashes": {"type": "object"},
          "ruling": {"type": ["string", "null"]},
          "blocker": {"type": ["string", "null"]},
          "expected_merge_parent": {"$ref": "#/$defs/nullableSha"},
          "next_command": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nullableSha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "nullableHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "process": {
      "type": "object",
      "required": [
        "pid",
        "start_time",
        "token",
        "task",
        "executable",
        "model",
        "argv",
        "observed_command",
        "events",
        "final",
        "segment",
        "session_id",
        "offset",
        "launch_count"
      ],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "start_time": {"type": "string", "minLength": 1},
        "token": {"type": "string", "minLength": 1},
        "task": {"type": "integer"},
        "executable": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "items": {"type": "string"}},
        "observed_command": {"type": "string", "minLength": 1},
        "events": {"type": "string"},
        "final": {"type": "string"},
        "segment": {"type": "integer", "minimum": 1},
        "session_id": {"type": ["string", "null"]},
        "offset": {"type": "integer", "minimum": 0},
        "launch_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
