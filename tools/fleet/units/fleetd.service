# systemd unit for fleetd (Linux hosts WITH systemd --user: i7 `server`).
#
# The work2 pod does NOT have systemd (it is a k8s container with
# neither systemd nor launchd -- see fleetd.py's `host_identity()`
# comment on its generated `work2box-<hash>` hostname). This file does
# not apply there; the pod uses tools/fleet/units/fleetd-wrapper.sh as
# its supervisor instead, kept alive by tools/fleet/units/cron-backstop.txt
# (T7, ARCH-FIX-SPEC.md R8).
#
# Install (as the OWNING user -- on the ryzen's ubuntuwork side that is
# swackhamer, not allen):
#   mkdir -p ~/.config/systemd/user
#   cp fleetd.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now fleetd
#   loginctl enable-linger $USER   # so it runs without a login session
[Unit]
Description=oxidex fleet reconciler (FLEET.md M2)
After=network-online.target

[Service]
Type=simple
# PLAN Stage 1 task 4: the hub (verdict/state) and the code repo
# (staging/* + refactor/tag-machinery) are now two distinct GitHub
# remotes -- the private state repo and the public code repo -- rather
# than one host-specific ssh URL. fleetd reads both from the
# environment; FLEET_CODE_URL falls back to FLEET_HUB_URL when unset.
Environment=FLEET_HUB_URL=https://github.com/swack-tools/oxidex-fleet-state.git
Environment=FLEET_CODE_URL=https://github.com/swack-tools/oxidex.git
# B5: both remotes above are private/public HTTPS GitHub repos, so every
# git op fleetd makes needs a token -- `tools/fleet/keel/git-credential-file`
# reads it from this file (never from argv or another env var fleetd._ps_env
# could read off this process). Create it with
# tools/fleet/rollout/install_secrets.sh, which also verifies it (0600,
# non-empty, a real `git ls-remote` against the state repo) without ever
# printing it. `%h` is systemd specifier syntax for this unit's HOME.
Environment=FLEET_GIT_TOKEN_FILE=%h/.keel/secrets/git-token
ExecStart=/usr/bin/python3 %h/fleet-checkout/tools/fleet/fleetd.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
