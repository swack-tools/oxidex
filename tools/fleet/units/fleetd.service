# systemd unit for keel-runner (Linux hosts WITH systemd --user: i7
# `server`). PLAN Stage 3 task 7: re-pointed from `fleetd.py` at
# `keel/runner.py` (SPEC SS2 C7 -- "fleetd.py's local half verbatim +
# outbound protocol + job journal"); the process this unit supervises
# and fleetd's own CLI/env contract are otherwise unchanged, so every
# comment below that still says "fleetd" is describing that contract,
# not a stale reference.
#
# A host with NEITHER systemd nor launchd (historically the work2 pod, a
# k8s container -- removed from the fleet 2026-08-22 with the rest of the
# ryzen) does not use this file; such a host runs
# tools/fleet/units/fleetd-wrapper.sh as its supervisor instead, kept
# alive by tools/fleet/units/cron-backstop.txt (T7, ARCH-FIX-SPEC.md R8).
#
# Install (as the OWNING user):
#   mkdir -p ~/.config/systemd/user ~/.keel/log
#   cp fleetd.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now fleetd
#   loginctl enable-linger $USER   # so it runs without a login session
[Unit]
Description=oxidex keel-runner (docs/AGENT-SERVER-SPEC.md C7)
After=network-online.target

[Service]
Type=simple
# PLAN Stage 1 task 4: the hub (verdict/state) and the code repo
# (staging/* + refactor/tag-machinery) are now two distinct GitHub
# remotes -- the private state repo and the public code repo -- rather
# than one host-specific ssh URL. The runner reads both from the
# environment; FLEET_CODE_URL falls back to FLEET_HUB_URL when unset.
# These (and KEEL_SERVER_URL/KEEL_TOKEN_FILE, below) are also settable
# via `~/.keel/runner.toml` (`keel/runner_toml.py`) -- an env var set
# here always wins over the toml file, so this unit's own values are a
# host-level floor an operator can still override without editing this
# file, not the only way to configure a host.
Environment=FLEET_HUB_URL=https://github.com/swack-tools/oxidex-fleet-state.git
Environment=FLEET_CODE_URL=https://github.com/swack-tools/oxidex.git
# B5: both remotes above are private/public HTTPS GitHub repos, so every
# git op the runner makes needs a token -- `tools/fleet/keel/git-credential-file`
# reads it from this file (never from argv or another env var fleetd._ps_env
# could read off this process). Create it with
# tools/fleet/rollout/install_secrets.sh, which also verifies it (0600,
# non-empty, a real `git ls-remote` against the state repo) without ever
# printing it. `%h` is systemd specifier syntax for this unit's HOME.
Environment=FLEET_GIT_TOKEN_FILE=%h/.keel/secrets/git-token
# L1 (Keel Stage 1 LIVE, 2026-08-27/28): a systemd --user service inherits
# systemd's own PATH, which carries no ~/.cargo/bin, while `gate.sh`
# prepends the fleet toolchain prefix before it resolves anything. The
# launchd plist for the macOS hosts already set a PATH for exactly this
# reason; this file -- the unit for the fleet's ONLY gate host -- never
# got the same treatment. `%h` is systemd's specifier for this unit's
# HOME. The first two segments must stay in step with
# tools/fleet/toolchain.py's TOOLCHAIN_PATH_PREFIX_REL and
# units/fleet-toolchain.sh's FLEET_TOOLCHAIN_PATH_PREFIX default.
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# L2 (same run): `hostname -s` is not the fleet name. The runner falls
# back to it when FLEET_HOST is unset, so a host whose seeded name differs
# reports under a name `refs/fleet/desired` has never heard of -- on the
# m5 that rendered as `refused: disabled ()`, an empty reason, plus an
# `Allens-Air` row in `fleet status --why` and no `m5` row at all. The
# identity is explicit here now. THIS VALUE IS PER HOST: it must match
# the key under `hosts` in tools/fleet/rollout/seed_desired.py (the i7 is
# seeded as `server`). If it is ever wrong, the runner now says
# `unknown-host` instead of `disabled`.
Environment=FLEET_HOST=server
# PLAN Stage 3 task 7: the optional keel-server route (SPEC SS4.3) --
# unset here on purpose. A host that should route its verdict cache and
# claim traffic through a keel-server sets KEEL_SERVER_URL (and, if the
# server requires auth, KEEL_TOKEN_FILE) via `~/.keel/runner.toml`
# instead of editing this unit; leaving them unset here means "direct to
# the hub" remains every host's out-of-the-box behaviour.
ExecStart=/usr/bin/python3 %h/fleet-checkout/tools/fleet/keel/runner.py
Restart=always
RestartSec=10
# PLAN Stage 3 task 7: logs under ~/.keel/log (not the systemd journal
# alone) -- the same directory every OTHER host-type's supervisor writes
# to (com.oxidex.fleetd.plist's StandardOutPath/StandardErrorPath,
# fleetd-wrapper.sh's LOG default), so `keel logs` and a human `tail -f`
# find the runner's output in the same place regardless of which
# supervisor started it. `journalctl --user -u fleetd` still works too;
# this is additive, not a replacement.
StandardOutput=append:%h/.keel/log/runner.log
StandardError=append:%h/.keel/log/runner.log

[Install]
WantedBy=default.target
