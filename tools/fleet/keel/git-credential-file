#!/bin/sh
# git credential helper: answer `get` with a token read from a FILE.
#
# WHY THIS EXISTS. The Keel spine is a GitHub repo over HTTPS (SPEC 8,
# "Credentials"): every runner holds a per-host fine-grained PAT at
# ~/.keel/secrets/git-token, 0600 (FLEET_GIT_TOKEN_FILE overrides the
# path). Git's other ways of getting that token all
# leak it or lose it:
#
#   * `https://<token>@github.com/...` in a remote URL puts the secret in
#     `git remote -v`, in every `_Result.describe()` this fleet logs, and
#     in the ref payloads that quote a URL.
#   * an `Authorization:` header via `http.extraHeader` puts it in
#     `GIT_CONFIG_VALUE_*`, which is an environment value, which
#     `fleetd._ps_env` reads off other processes by design.
#   * the host's own credential helper (osxkeychain on the laptops, the
#     1Password ssh agent this fleet has been bitten by before) answers
#     with whatever the human happened to log in as, not with the host's
#     scoped PAT -- and it answers FIRST.
#
# A helper reading a file has none of those properties: the token crosses
# exactly one pipe, from this script's stdout into git, and is never an
# argument, never an environment value, and never written to a log. The
# only thing on disk is the file the operator already put there.
#
# CONTRACT (gitcredentials(7)). Invoked as `<helper> <operation>` with the
# credential request on stdin as `key=value` lines terminated by a blank
# line. For `get`, a helper supplies what it knows on stdout and exits 0;
# supplying NOTHING and exiting 0 is the documented way to say "I have no
# credential for this", and git then moves on to the next helper (there is
# none -- fleetlib resets the list) or fails the operation. That is the
# behaviour every refusal below takes, deliberately: this script must never
# be the reason a git command dies with a shell error, only ever the reason
# it dies with git's own clear authentication error.
#
# `store` and `erase` are accepted and do nothing. A helper that cannot
# store cannot cache a token anywhere the operator did not put it, which is
# the point; git treats a silent, successful `store` as fine.
#
# NEVER add `set -x`, and never echo $token anywhere but the single
# `printf 'password=%s\n'` below. `>&2` is for diagnostics that name PATHS.
#
# Environment:
#   FLEET_GIT_TOKEN_FILE  (required) path to a file whose FIRST LINE is the
#                         token. Everything after the first line is ignored,
#                         so an operator comment on line 2 is harmless.
#   FLEET_GIT_TOKEN_USER  (optional) username to present; defaults to
#                         `x-access-token`. GitHub accepts any username
#                         when the password is a PAT, and that spelling is
#                         the one its own docs use.
#   FLEET_GIT_TOKEN_HOST  (optional) the ONE host this token answers for;
#                         defaults to `github.com`. `credential_env` resets
#                         the helper list (see the decoy note above) so
#                         this helper is consulted for every https remote a
#                         fleet git command touches, not only the state
#                         repo -- SPEC 8 scopes each runner's PAT to
#                         `state: contents write` + `code: contents read`,
#                         both on github.com today, but a host= mismatch is
#                         refused the same way a protocol mismatch is
#                         (silently, so git can still ask its next
#                         resolved credential) rather than handed the
#                         wrong remote's token by default.

set -u

op="${1:-}"

# Drain the request. git writes the whole request and waits for our
# answer; reading it out is also what keeps `store`/`erase` from handing
# git an EPIPE on a pipe we walked away from.
protocol=""
host=""
while IFS= read -r line; do
    [ -n "$line" ] || break
    case "$line" in
        protocol=*) protocol="${line#protocol=}" ;;
        host=*) host="${line#host=}" ;;
        *) ;;
    esac
done

case "$op" in
    get) ;;
    store|erase) exit 0 ;;
    *) exit 0 ;;
esac

# Plain HTTP would put the token on the wire in clear text; refuse rather
# than supply it. ssh never reaches a credential helper at all.
if [ "$protocol" != "https" ]; then
    exit 0
fi

# Answer only for the ONE host this token is scoped to (M1: a helper that
# answers for any host hands the state-repo PAT to whatever other HTTPS
# remote a git command happens to touch first -- `git credential fill` is
# consulted per-request, keyed by protocol+host, and this is the only
# place in the request that says which remote is asking). Per
# gitcredentials(7) `host=` is `host` or `host:port` -- a URL's userinfo
# (`https://user@host/...`) arrives in a separate `username=` field, never
# folded into `host=` -- so only the port needs stripping before the
# comparison (confirmed live: `git credential fill` with
# `url=https://user@github.com/x` produces `host=github.com` +
# `username=user`, never `host=user@github.com`).
configured_host="${FLEET_GIT_TOKEN_HOST:-github.com}"
compare_host="${host%%:*}"
if [ "$compare_host" != "$configured_host" ]; then
    exit 0
fi

token_file="${FLEET_GIT_TOKEN_FILE:-}"
if [ -z "$token_file" ]; then
    echo "git-credential-file: FLEET_GIT_TOKEN_FILE is not set" >&2
    exit 0
fi
if [ ! -r "$token_file" ]; then
    echo "git-credential-file: cannot read token file: $token_file" >&2
    exit 0
fi

# First line only, with any CR from a file written on Windows stripped.
token="$(head -n 1 "$token_file" | tr -d '\r\n')"
if [ -z "$token" ]; then
    echo "git-credential-file: token file is empty: $token_file" >&2
    exit 0
fi

# printf, not echo: the token is an ARGUMENT to a fixed format string, so a
# token containing `%` or a leading `-` cannot be reinterpreted.
printf 'username=%s\n' "${FLEET_GIT_TOKEN_USER:-x-access-token}"
printf 'password=%s\n' "$token"
