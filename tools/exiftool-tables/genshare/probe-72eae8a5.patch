+/// PROBE (never land): true when `compute` would reach a
+/// `generated_compute` arm for this pair, i.e. `compute`'s own match has no
+/// hand arm for it and the generated file does.
+pub(super) fn is_generated_compute(module: &str, name: &str) -> bool {
+    matches!(
