diff --git a/src/probe_silence.rs b/src/probe_silence.rs
new file mode 100644
index 00000000..e8f5e0fa
--- /dev/null
+++ b/src/probe_silence.rs
@@ -0,0 +1,148 @@
+//! PROBE (never land): `OXIDEX_PROBE_SILENCE` drops output rows at the outward
+//! boundary of a class of generated-data producers, so a census with and
+//! without the switch measures how many *observed* rows each class supplies.
+//!
+//! Read once per process from the environment (comma-separated tokens).
+//! Unset or empty is normal behaviour: every gate below is a no-op and the
+//! output is byte-identical to the unmodified tree.
+//!
+//! Tokens (a class token is the union of its sub-tokens):
+//!
+//! * `engine` -- the two `Emitted` pushes of the generic engines
+//!   (`engine.rs` binary walk, `ifd_engine.rs` IFD walk). Walk state
+//!   (SetMember, guards, descents) runs before the push and is kept.
+//! * `legacy` = `legacy-l1` + `legacy-l2` + `legacy-l3`
+//!   * `legacy-l1` -- `runtime::DecodedField::emit` returns `None` (generated
+//!     layout + generated conversion, including the hybrid consumers that feed
+//!     `emit()`'s value into hand formatting). `RawAccess` rows are NOT
+//!     silenced (layout generated, conversion acknowledged/hand); see probe.md.
+//!   * `legacy-l2` -- manifest vendor walkers: `binary_subdir.rs`,
+//!     `canon/custom_functions2.rs`, `app_segments/infiray.rs`,
+//!     `sony.rs` main_extra, and the shared Sony walker when it walks
+//!     `minolta_a100_tables::TABLES`.
+//!   * `legacy-l3` -- generated-origin tables with no committed generator:
+//!     the shared Sony walker over `sony/plain_tables` / `sony/enciphered_tables`,
+//!     `nikon/binary_data.rs` (encrypted), `nikon/settings.rs`,
+//!     `canon/binary_tables.rs`, `canon/camera_info.rs`, `canon/filter_info.rs`,
+//!     `canon/color_data.rs`, `canon_vrd/mod.rs` VER1.
+//! * `producers` = `producers-identity` + `producers-composite` +
+//!   `producers-dicom` + `producers-geotiff` + `producers-fits`
+//!   * `producers-identity` -- the generated `filetype` writes of
+//!     `File:FileType`/`FileTypeExtension`/`MIMEType`
+//!     (`file_metadata.rs`, `operations.rs::add_identity_tags`,
+//!     `flir_fpf.rs`, `canon_vrd::set_identity`, `elf` MIMEType). Hand
+//!     writers and `normalize_identity_tags`' hand fallback still run.
+//!   * `producers-composite` -- the three `generated_compute` arms only
+//!     (the only Composite rows with a generated computation).
+//!   * `producers-dicom`, `producers-geotiff` -- rows named by the generated
+//!     DICOM dictionary / GeoKey table.
+//!   * `producers-fits` -- FITS rows whose name came from `FITS_TAG_NAMES`.
+//! * `composite-declared` -- NOT part of `producers`: every Composite row the
+//!   `composite::apply` loop emits (generated declaration, mostly hand
+//!   computation). A hybrid bound, reported separately.
+//! * `conv` -- refused: there is no clean choke point (silencing a generated
+//!   PrintConv lookup makes a value wrong, not absent). Exits 2.
+//!
+//! Any unknown token also exits 2: a typo must never measure as "no change".
+
+use std::sync::OnceLock;
+
+/// One silenceable boundary.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u32)]
+pub enum Class {
+    Engine = 0,
+    LegacyL1 = 1,
+    LegacyL2 = 2,
+    LegacyL3 = 3,
+    Identity = 4,
+    Composite = 5,
+    Dicom = 6,
+    GeoTiff = 7,
+    Fits = 8,
+    CompositeDeclared = 9,
+}
+
+const fn bit(c: Class) -> u32 {
+    1 << (c as u32)
+}
+
+const LEGACY: u32 = bit(Class::LegacyL1) | bit(Class::LegacyL2) | bit(Class::LegacyL3);
+const PRODUCERS: u32 = bit(Class::Identity)
+    | bit(Class::Composite)
+    | bit(Class::Dicom)
+    | bit(Class::GeoTiff)
+    | bit(Class::Fits);
+
+static MASK: OnceLock<u32> = OnceLock::new();
+
+fn parse(spec: &str) -> Result<u32, String> {
+    let mut mask = 0;
+    for token in spec.split(',').map(str::trim).filter(|t| !t.is_empty()) {
+        mask |= match token {
+            "engine" => bit(Class::Engine),
+            "legacy" => LEGACY,
+            "legacy-l1" => bit(Class::LegacyL1),
+            "legacy-l2" => bit(Class::LegacyL2),
+            "legacy-l3" => bit(Class::LegacyL3),
+            "producers" => PRODUCERS,
+            "producers-identity" => bit(Class::Identity),
+            "producers-composite" => bit(Class::Composite),
+            "producers-dicom" => bit(Class::Dicom),
+            "producers-geotiff" => bit(Class::GeoTiff),
+            "producers-fits" => bit(Class::Fits),
+            "composite-declared" => bit(Class::CompositeDeclared),
+            "conv" => {
+                return Err("OXIDEX_PROBE_SILENCE=conv is not implemented: generated \
+                            PrintConv lookups have no clean choke point (a silenced \
+                            lookup yields a wrong value, not an absent row)"
+                    .to_string());
+            }
+            other => return Err(format!("OXIDEX_PROBE_SILENCE: unknown token {other:?}")),
+        };
+    }
+    Ok(mask)
+}
+
+fn mask() -> u32 {
+    *MASK.get_or_init(|| match std::env::var("OXIDEX_PROBE_SILENCE") {
+        Err(_) => 0,
+        Ok(spec) => match parse(&spec) {
+            Ok(mask) => mask,
+            Err(message) => {
+                eprintln!("{message}");
+                std::process::exit(2);
+            }
+        },
+    })
+}
+
+/// True when rows of class `c` must be dropped at their outward boundary.
+#[inline]
+#[must_use]
+pub fn silenced(c: Class) -> bool {
+    mask() & bit(c) != 0
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tokens_parse_to_the_documented_unions() {
+        assert_eq!(parse("").unwrap(), 0);
+        assert_eq!(parse(" , ").unwrap(), 0);
+        assert_eq!(parse("legacy").unwrap(), LEGACY);
+        assert_eq!(
+            parse("legacy-l1,legacy-l2,legacy-l3").unwrap(),
+            parse("legacy").unwrap()
+        );
+        assert_eq!(
+            parse("producers").unwrap() & bit(Class::CompositeDeclared),
+            0
+        );
+        assert_eq!(parse("engine").unwrap(), bit(Class::Engine));
+        assert!(parse("conv").is_err());
+        assert!(parse("enigne").is_err());
+    }
+}
