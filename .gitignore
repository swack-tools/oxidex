# CodeMachine directories (only exclude memory and artifacts, keep prompts and templates)
.codemachine/memory/
.codemachine/artifacts/

# Node modules
node_modules

# Environment variables
.env
.env.local
.env.*.local

# Driver B model config (holds API keys) -- see config.example.toml
config.toml
# ...and every hand-rolled backup of it. These hold the SAME live API keys as
# config.toml itself, and the pattern above does not cover them. This is not a
# hypothetical: commit 85a24f04390d ("fix(dng): wire 1 missing tags") swept
# `config.toml.bak-pre-gpt55` -- 163 lines including two live wfr_* keys -- into
# a worker branch, because the fleet's `git add -A` found an unignored file that
# happened to be sitting in the worktree root. Any operator who backs up
# config.toml before an edit creates one of these; the pattern has to catch them
# all rather than depend on remembering to put each one somewhere safe.
config.toml.bak*

# Driver B parallel-run worker logs (default --log-dir)
/logs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode
.idea
*.swp
*.swo
*~


# Rust build artifacts
/target/

# Local parity-comparison captures. These contain machine-specific paths,
# timestamps, and large corpus output; retain the reproducible tools, not a
# generated run's results.
/runs/
**/*.rs.bk
*.pdb

# Keep the workspace lockfile for reproducible CLI and container builds, but
# continue excluding lockfiles created inside library/fuzz subcrates.
**/Cargo.lock
!Cargo.lock

# Fuzzing artifacts (keep named corpus seed files like *.pdf, *.mp4, exclude fuzzer-generated hash files)
fuzz/target/
fuzz/artifacts/
# Exclude all files in corpus directories
fuzz/corpus/*/*
# But keep named seed files (*.pdf, *.mp4, etc.)
!fuzz/corpus/*/*.pdf
!fuzz/corpus/*/*.mp4
!fuzz/corpus/*/*.jpg
!fuzz/corpus/*/*.png

# Benchmark outputs
benches/target/

# Claude Code config
# A directory pattern ending in "/" prunes the directory from traversal
# entirely, so per-file "!" negations below it never get evaluated -- hence
# ".claude/*" (matching only direct entries) rather than ".claude/", so the
# workflows negation below actually takes effect.
.claude/*
# ...except saved Workflow scripts, which are checked-in tooling, not local config
!.claude/workflows/
!.claude/workflows/**
# ...and skills that are shared team tooling rather than local config. Skills are
# allowlisted one at a time: un-ignore the directory so git descends into it,
# re-ignore its direct entries, then negate each shared skill. To share another
# skill, add one more "!.claude/skills/<name>/" line.
!.claude/skills/
.claude/skills/*
!.claude/skills/exiftool-parity/

# Git worktrees
.worktrees/

# Helper scripts and temporary files
generate_tags.py
additional_tags.txt
exif_additional.txt
new_tags.txt
test_tag_lookup
test_tag_lookup.rs

# Codemachine temporary/draft files
.codemachine/inputs/*.3.md
.codemachine/inputs/*.4md

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# macOS metadata files
.DS_Store
**/.DS_Store


# Ignore vscode AI rules
.github/instructions/codacy.instructions.md

# Codacy CLI
.codacy/

# Ignore target in all workspace crates (fix for exiftool-tags-core/target/)
**/target/

# Cache and data directories
.cache/
.data/

# Examples directory
examples/

# Profiling data files
profile*.json
profile*.json.gz
flamegraph*.svg
stacks.txt
dtrace.out
perf.data
perf.data.old

# Claude Flow and Swarm directories
.claude-flow/
.swarm/

# TrID definitions
triddefs.trd

# VitePress build output (built by CI)
docs/.vitepress/dist/
docs/.vitepress/cache/

# ExifTool comparison reports (generated at deploy time)
docs/reference/comparison/

# Generated HTML files in docs (VitePress generates from .md at build time)
docs/**/*.html

# Build artifacts
build.log

# Quibbler hook artifacts
.quibbler/


#Ignore cursor AI rules
.cursor/rules/codacy.mdc
comparison.json

# Local overhaul progress ledger -- deliberately untracked (plan rule 8):
# it is per-session state and would conflict across parallel step branches.
OVERHAUL_PROGRESS.md
